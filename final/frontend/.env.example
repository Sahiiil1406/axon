# Development / vite preview: forward /api to the existing FinalCounter server.
AXON_API_PROXY_TARGET=http://127.0.0.1:8900

# Production normally serves /api on the same origin using a reverse proxy.
# Set this only when the backend is at a different base URL and supports CORS.
# Public frontend configuration only; never put signing keys here.
VITE_AXON_API_URL=
